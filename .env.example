# Server-only environment variables.
# Never expose these through Vite or any VITE_* variable.
# Copy to .env.local and fill in locally. .env.local is gitignored.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Deep discussion: thinking is enabled by default in real mode.
DEEPSEEK_THINKING=enabled

# LLM timeouts (ms); thinking needs more headroom.
LLM_TIMEOUT_ROSTER_MS=60000
LLM_TIMEOUT_DECISION_MS=45000
LLM_TIMEOUT_SPEECH_MS=90000
LLM_TIMEOUT_INSIGHT_MS=45000
LLM_TIMEOUT_SUMMARY_MS=90000
LLM_FIRST_TOKEN_MS=20000

# LLM mode: mock | real. Use mock for tests and CI.
LLM_MODE=mock

# Mock-only: delay each mock call (ms). 600-1200 makes the live stage visible.
MOCK_DELAY_MS=0

PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/app.db
LOG_LEVEL=info
